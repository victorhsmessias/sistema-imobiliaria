# ---------------------------------------------------------------------------
# Banco de dados
#
# Duas URLs, de proposito. O isolamento por tenant depende disso:
#   - app_migrator: dono das tabelas, roda migrations. IGNORA RLS.
#   - app_user:     runtime da aplicacao. SUJEITO a RLS, sem BYPASSRLS.
#
# A API NUNCA deve usar DATABASE_URL_MIGRATOR. Se ela usar, o RLS vira enfeite
# e a anonimizacao cross-tenant deixa de existir.
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://app_user:app_user_dev@localhost:5434/imob
DATABASE_URL_MIGRATOR=postgres://app_migrator:app_migrator_dev@localhost:5434/imob

# Usada SOMENTE pela suite de testes, como "oraculo": a conexao que enxerga
# tudo, para comparar contra o que a aplicacao enxerga. Um teste de
# anonimizacao precisa saber qual e a verdade antes de afirmar que ela nao
# vazou. Nao existe em producao e nenhum codigo de aplicacao a le.
#
# Nota: app_migrator NAO serve para isso -- properties e property_media tem
# FORCE ROW LEVEL SECURITY, entao o proprio dono das tabelas tambem e filtrado.
DATABASE_URL_TEST_ORACLE=postgres://postgres:postgres@localhost:5434/imob

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-isto-em-producao-minimo-32-bytes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Storage S3-compativel (dev: MinIO | prod: Cloudflare R2)
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=imob-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# TTL das URLs assinadas servidas em resultado de busca (segundos)
S3_SIGNED_URL_TTL=300

# ---------------------------------------------------------------------------
# Servicos
# ---------------------------------------------------------------------------
API_PORT=3333
API_HOST=0.0.0.0
# Saltos de proxy confiaveis a frente da API. Cadeia padrao: Traefik -> Next -> API = 1.
# Nunca "true": isso faria a API confiar num X-Forwarded-For escrito pelo cliente.
TRUST_PROXY_HOPS=1
API_INTERNAL_URL=http://localhost:3333
# 3000 ja esta ocupada nesta maquina (projeto Documentos/Imobiliaria).
WEB_PORT=3100
WEB_PUBLIC_URL=http://localhost:3100
NODE_ENV=development
LOG_LEVEL=debug
