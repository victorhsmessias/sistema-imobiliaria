{
  "name": "sistema-imob",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:infra": "docker compose -f docker/docker-compose.dev.yml up -d",
    "dev:infra:down": "docker compose -f docker/docker-compose.dev.yml down",
    "dev:infra:reset": "docker compose -f docker/docker-compose.dev.yml down -v && pnpm dev:infra",
    "db:generate": "pnpm --filter @imob/db generate",
    "db:migrate": "pnpm --filter @imob/db migrate",
    "db:seed": "pnpm --filter @imob/db seed && pnpm --filter @imob/api seed:media",
    "db:seed:media": "pnpm --filter @imob/api seed:media",
    "db:studio": "pnpm --filter @imob/db studio",
    "dev:api": "pnpm --filter @imob/api dev",
    "test": "pnpm -r test",
    "test:rls": "pnpm --filter @imob/db test",
    "test:api": "pnpm --filter @imob/api test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "catalog:export": "pnpm --filter @imob/db catalog:export",
    "catalog:import": "pnpm --filter @imob/db catalog:import",
    "dev:web": "pnpm --filter @imob/web dev"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
