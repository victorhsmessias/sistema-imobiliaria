# ---------------------------------------------------------------------------
# API (Fastify) e migrations.
#
# A MESMA imagem serve para dois papeis, de proposito:
#   - runtime da API   -> CMD padrao, conecta como app_user (sujeito a RLS)
#   - passo de migrate -> override do comando, conecta como app_migrator
#
# Duas imagens separadas so multiplicariam o risco de a migration rodar com a
# versao errada do schema. Quem separa os dois papeis e a CREDENCIAL, nao a
# imagem: a API recusa subir se DATABASE_URL apontar para o migrator
# (assertRuntimeRole em packages/db/src/client.ts).
#
# Base glibc (bookworm), e nao alpine: sharp e @node-rs/argon2 tem binarios
# pre-compilados para glibc; em musl a instalacao cai para compilar do fonte.
# ---------------------------------------------------------------------------
FROM node:22-bookworm-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /app

# ---------------------------------------------------------------------------
# Dependencias de producao apenas.
#
# Os manifests entram antes do codigo: enquanto eles nao mudam, o Docker
# reaproveita esta camada e o deploy nao reinstala tudo a cada commit.
# ---------------------------------------------------------------------------
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/api/package.json          apps/api/
COPY packages/db/package.json       packages/db/
COPY packages/contracts/package.json packages/contracts/
RUN pnpm install --frozen-lockfile --prod --filter @imob/api...

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
FROM base AS runtime
ENV NODE_ENV=production

COPY --from=deps /app/node_modules                   ./node_modules
COPY --from=deps /app/apps/api/node_modules          ./apps/api/node_modules
COPY --from=deps /app/packages/db/node_modules       ./packages/db/node_modules
COPY --from=deps /app/packages/contracts/node_modules ./packages/contracts/node_modules

COPY package.json pnpm-workspace.yaml ./
COPY apps/api          ./apps/api
COPY packages/db       ./packages/db
COPY packages/contracts ./packages/contracts

# Nao roda como root: uma falha de path traversal no processo nao vira acesso
# de administrador dentro do container.
USER node
# cwd dentro do pacote: com pnpm, `tsx` vive em apps/api/node_modules, e
# `node --import tsx` resolve a partir do diretorio corrente.
WORKDIR /app/apps/api
EXPOSE 3333

# O healthcheck do EasyPanel usa a mesma rota; aqui ele vale para `docker run`.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.API_PORT||3333)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

# Migration NAO roda aqui: e um passo separado no deploy, com a credencial do
# migrator (ver docs/deploy.md). Rodar no start do container criaria corrida
# entre replicas subindo ao mesmo tempo.
#
# O passo de migration usa esta mesma imagem, trocando o comando por:
#   node --import tsx ../../packages/db/src/migrate.ts
CMD ["node", "--import", "tsx", "src/server.ts"]
