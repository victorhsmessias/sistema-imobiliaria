# ---------------------------------------------------------------------------
# Web (Next.js 15) — UI e BFF.
#
# O navegador fala SO com este servico; ele repassa para a API pela rede
# interna. Por isso API_INTERNAL_URL aponta para o nome do servico, e a API
# nao precisa estar exposta na internet.
# ---------------------------------------------------------------------------
FROM node:22-bookworm-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /app

# ---------------------------------------------------------------------------
# Build: precisa das dependencias de desenvolvimento (next, typescript).
# ---------------------------------------------------------------------------
FROM base AS build
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/web/package.json           apps/web/
COPY packages/contracts/package.json packages/contracts/
RUN pnpm install --frozen-lockfile --filter @imob/web...

COPY apps/web           ./apps/web
COPY packages/contracts ./packages/contracts
COPY tsconfig.base.json ./

# Telemetria desligada: build de produção não manda dados para fora.
ENV NEXT_TELEMETRY_DISABLED=1
# Liga o empacotamento standalone (ver apps/web/next.config.ts). Fica aqui, e
# nao no config, porque criar os symlinks do standalone falha com EPERM no
# Windows -- e o build local nao tem por que pagar por um artefato de imagem.
ENV NEXT_OUTPUT_STANDALONE=1
RUN pnpm --filter @imob/web build

# Falha cedo se o standalone nao tiver sido gerado: sem isto, o erro so
# apareceria como "Cannot find module" no start do container.
RUN test -f apps/web/.next/standalone/apps/web/server.js

# ---------------------------------------------------------------------------
# Runtime: só o standalone. Sem pnpm, sem código-fonte, sem devDependencies.
# ---------------------------------------------------------------------------
FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /app

# O standalone traz o server.js e um node_modules mínimo, já resolvido.
COPY --from=build /app/apps/web/.next/standalone ./
COPY --from=build /app/apps/web/.next/static     ./apps/web/.next/static

USER node
EXPOSE 3100
ENV PORT=3100
ENV HOSTNAME=0.0.0.0

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3100)+'/login').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "apps/web/server.js"]
